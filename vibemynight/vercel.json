{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/flutter_app/build/web",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://vibemynight.onrender.com/sitemap.xml"
    },
    {
      "source": "/sitemap-(.*)\\.xml",
      "destination": "https://vibemynight.onrender.com/sitemap-$1.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://vibemynight.onrender.com/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://vibemynight.onrender.com/api/$1"
    },
    {
      "source": "/events/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|whatsapp|Twitterbot|twitterbot|TelegramBot|telegrambot|LinkedInBot|Discordbot|SkypeUriPreview|Googlebot|googlebot|bingbot|PinterestBot|vkShare|quora|outbrain|embedly|bitlybot).*"
        }
      ],
      "destination": "https://vibemynight.onrender.com/events/$1"
    },
    {
      "source": "/artists/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|whatsapp|Twitterbot|twitterbot|TelegramBot|telegrambot|LinkedInBot|Discordbot|SkypeUriPreview|Googlebot|googlebot|bingbot|PinterestBot|vkShare|quora|outbrain|embedly|bitlybot).*"
        }
      ],
      "destination": "https://vibemynight.onrender.com/artists/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
