{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/flutter_app/build/web",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://vibemynight.onrender.com/sitemap.xml"
    },
    {
      "source": "/sitemap-:slug(.*)\\.xml",
      "destination": "https://vibemynight.onrender.com/sitemap-:slug.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://vibemynight.onrender.com/robots.txt"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://vibemynight.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
