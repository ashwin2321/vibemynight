{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/flutter_app/build/web",
  "buildCommand": "export PATH=$PATH:$(pwd)/flutter/bin && cd frontend/flutter_app && flutter pub get && flutter build web --release --no-tree-shake-icons",
  "rewrites": [
    {
      "source": "/events/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|LinkedInBot|Slackbot|Discordbot|SkypeUriPreview|Googlebot|bingbot|Pinterestbot|quora|vkShare|Embedly|outbrain).*"
        }
      ],
      "destination": "https://vibemynight.onrender.com/events/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
