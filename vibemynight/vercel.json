{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "frontend/flutter_app/build/web",
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://vibemynight.onrender.com/api/$1"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "https://vibemynight.onrender.com/sitemap.xml"
    },
    {
      "src": "^/sitemap-(.*)\\.xml$",
      "dest": "https://vibemynight.onrender.com/sitemap-$1.xml"
    },
    {
      "src": "^/robots\\.txt$",
      "dest": "https://vibemynight.onrender.com/robots.txt"
    },
    {
      "src": "^/events/([^/]+)$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|SkypeUriPreview|Googlebot|bingbot|PinterestBot|vkShare|quora|outbrain|embedly|bitlybot).*"
        }
      ],
      "dest": "https://vibemynight.onrender.com/events/$1"
    },
    {
      "src": "^/artists/([^/]+)$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|SkypeUriPreview|Googlebot|bingbot|PinterestBot|vkShare|quora|outbrain|embedly|bitlybot).*"
        }
      ],
      "dest": "https://vibemynight.onrender.com/artists/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/.*$",
      "dest": "/index.html"
    }
  ]
}
