# ---- Database ----
DATABASE_URL=jdbc:mysql://localhost:3306/vibemynight?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=root

# ---- Security ----
JWT_SECRET=change_me_to_a_long_random_secret_in_production
JWT_EXPIRATION_MS=86400000

# Admin seed user (used by a data seeder / migration, not committed with real values)
ADMIN_SEED_EMAIL=admin@vibemynight.com
ADMIN_SEED_PASSWORD=Admin@123

# ---- Image storage ----
# For v1: local disk storage. Swap IMAGE_STORAGE_URL / KEY for a cloud provider later
# without changing application code (see service/ImageStorageService abstraction).
IMAGE_STORAGE_URL=http://localhost:8080/uploads
IMAGE_STORAGE_KEY=
IMAGE_STORAGE_LOCAL_PATH=./uploads

# ---- WhatsApp ----
# Official VibeMyNight number, international format, no plus sign, no hardcoding in frontend.
WHATSAPP_NUMBER=917041615131

# ---- CORS ----
# Comma-separated origins the Flutter Web app is served from. Without this,
# Flutter Web cannot call the API at all - the browser blocks it at the CORS
# preflight. Wildcard patterns are allowed (e.g. http://localhost:*) for
# local dev; set this explicitly for any real deployment.
CORS_ALLOWED_ORIGINS=http://localhost:*
