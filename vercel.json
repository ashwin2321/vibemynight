{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "vibemynight/frontend/flutter_app/build/web",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://vibemynight.onrender.com/sitemap.xml"
    },
    {
      "source": "/sitemap-:slug.xml",
      "destination": "https://vibemynight.onrender.com/sitemap-:slug.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "https://vibemynight.onrender.com/robots.txt"
    },
    {
      "source": "/api/:path*",
      "destination": "https://vibemynight.onrender.com/api/:path*"
    },
    {
      "source": "/events/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|SkypeUriPreview|Googlebot|bingbot|PinterestBot|vkShare|quora|outbrain|embedly|bitlybot).*"
        }
      ],
      "destination": "https://vibemynight.onrender.com/events/:slug"
    },
    {
      "source": "/artists/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|WhatsApp|Twitterbot|TelegramBot|LinkedInBot|Discordbot|SkypeUriPreview|Googlebot|bingbot|PinterestBot|vkShare|quora|outbrain|embedly|bitlybot).*"
        }
      ],
      "destination": "https://vibemynight.onrender.com/artists/:slug"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.wasm",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
